# Root-level env, used by standalone scripts run from the repo root
# (e.g. `pnpm db:seed`). Copy to .env.local and fill in your own values.
# Next.js apps (apps/web, apps/admin) each have their own .env.example —
# this file does NOT get loaded by `next dev`/`next build`.

# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, add a database user, and copy the
# "Connect your application" URI (include a database name, e.g. /monocoupon).
MONGODB_URI=

# Credentials the seed script creates the initial admin user with.
# Safe to leave as-is for local dev; change before seeding a shared/staging DB.
SEED_ADMIN_EMAIL=admin@monocoupon.com
SEED_ADMIN_PASSWORD=ChangeMe123!
