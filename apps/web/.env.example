# Copy to .env.local for local development. More vars will be added here
# as later build phases (SEO, analytics, security) wire them up.

MONGODB_URI=

# Any long random string — used to HMAC-hash visitor IPs before storing them
# on TrackingEvent (site-wide visitor analytics) and ClickEvent (coupon/store
# click tracking, not yet wired up), so raw IPs are never persisted. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Shared secret the admin app sends when calling POST /api/revalidate after
# a mutation, so edits show up on the public site without waiting for ISR.
# Must match REVALIDATE_SECRET in apps/admin/.env.local exactly.
REVALIDATE_SECRET=

# Rate limiting for the /go/[slug] affiliate-redirect endpoint (guards
# against click-fraud/bot abuse), plus the contact and newsletter forms.
# Create a free Redis database at https://console.upstash.com — use the
# SAME database as apps/admin/.env.local (namespaced separately by key
# prefix, one Redis DB covers both).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email delivery for the contact form notification and newsletter welcome
# email. Get a key at https://resend.com/api-keys (free tier: 100/day,
# 3000/month). Without a verified sending domain, Resend's sandbox sender
# only delivers to your own account email — see RESEND_FROM_EMAIL below.
RESEND_API_KEY=

# Sender address for outgoing email. Requires verifying a domain in Resend
# (https://resend.com/domains) — until then, leave unset to use Resend's
# sandbox sender (onboarding@resend.dev), which only delivers to your own
# Resend account email, not real visitors.
RESEND_FROM_EMAIL=

# Bot protection on the contact form (Cloudflare Turnstile). Create a free
# widget at https://dash.cloudflare.com -> Turnstile -> Add site — use a
# SEPARATE widget from apps/admin's (different domain/subdomain scope).
# "localhost" works for local dev. Both must be set together — the widget
# only renders when the site key is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OPTIONAL — ASN/datacenter detection for the fraud scorer. Create a free
# token at https://ipinfo.io (50k lookups/month). When set, each tracked
# visit records the organization owning the IP and whether it's a
# hosting/cloud range (AWS, GCP, Hetzner, ...) — a strong bot signal.
# Leave unset to skip the lookup entirely.
IPINFO_TOKEN=

# OPTIONAL — any long random string. When set, the middleware signs its
# server-side paid-click logs (source: "server") with it so outsiders can't
# forge them by POSTing to /api/track with x-mc-source: server.
TRACK_SERVER_KEY=

# Analytics writes are skipped outside production so local dev browsing
# doesn't pollute real visitor data. Set to 1 to test tracking locally.
TRACK_IN_DEV=

# Protects the cache-warmer endpoint (GET /api/cron/warm), which keeps every PPC
# store landing page resident in the ISR cache so paid clicks never hit a cold
# render. The route requires `Authorization: Bearer <CRON_SECRET>` and rejects
# anything else. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in THREE places so they all match:
#   - Vercel project Environment Variables (Production) — used by the route, and
#     auto-sent by the once-daily Vercel Cron fallback (vercel.json).
#   - GitHub repo secret CRON_SECRET — the hourly GitHub Actions warmer
#     (.github/workflows/warm-cache.yml) sends it. (Hobby Vercel Cron is
#     daily-only, so GitHub Actions drives the real hourly cadence.)
CRON_SECRET=

# Verifies POST /api/webhooks/vercel-deploy actually came from Vercel — every
# production deploy fires this so already-cached ISR pages from the PREVIOUS
# deployment get busted and the PPC set re-warmed, instead of silently
# serving pre-deploy content for up to 24h (revalidate window on store
# pages). Vercel signs the raw request body with HMAC-SHA1 using this value.
# One-time setup:
#   1. Deploy this branch first — the endpoint must exist before the webhook
#      can be created.
#   2. From apps/web: npx vercel webhooks create
#        https://monocoupon.com/api/webhooks/vercel-deploy \
#        --event deployment.succeeded --project <web project ID>
#      (project ID is in apps/web/.vercel/project.json; deployment.ready is
#      NOT accepted at project scope, only deployment.succeeded is)
#   3. The command prints a secret ONCE — set it as VERCEL_WEBHOOK_SECRET in
#      Vercel project Environment Variables (Production). It is NOT the same
#      as your Vercel account/API token.
VERCEL_WEBHOOK_SECRET=
