# Copy to .env.local for local development.

MONGODB_URI=

# Auth.js. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Must match REVALIDATE_SECRET in apps/web/.env.local exactly. Used to call
# the public site's /api/revalidate endpoint after a create/update/delete
# so changes appear immediately instead of waiting for the next ISR window.
REVALIDATE_SECRET=
WEB_APP_URL=http://localhost:3000

# AI-assist (admin "Generate with AI" buttons on descriptions and blog drafts)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional, free tier: lets you pick Groq models on the AI Models page.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# AI-assist (blog cover image generation)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Image generation on Cloudflare Workers AI (free daily allowance, no card).
# Account ID: dash.cloudflare.com > Workers AI. Token: My Profile > API Tokens > Workers AI template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Rate limiting for the AI-assist and login endpoints. Create a free Redis
# database at https://console.upstash.com — the REST URL and token are shown
# on the database's detail page. Use the SAME database as apps/web/.env.local
# (they're namespaced separately by key prefix, one Redis DB covers both).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Storage for AI-generated images. Create a Blob store at
# https://vercel.com/dashboard -> Storage -> Create Database -> Blob
# (works for local dev too, no deployment required first).
BLOB_READ_WRITE_TOKEN=

# Bot protection on the login form (Cloudflare Turnstile). Create a free
# widget at https://dash.cloudflare.com -> Turnstile -> Add site (any domain
# works for local dev, e.g. localhost). Both must be set together — the
# widget only renders when the site key is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
